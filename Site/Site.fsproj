<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <OutputType>Library</OutputType>
    <WebSharperSourceMap>false</WebSharperSourceMap>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Samples.fs" />
    <Compile Include="Circles.fs" />
    <Compile Include="Graphs.fs" />
    <Compile Include="Shapes.fs" />
    <Compile Include="WorldTour.fs" />
    <Compile Include="Client.fs" />
    <Content Include="index.html" />
    <None Include="site.css" />
    <None Include="sp500.csv" />
    <None Include="topojson.v1.min.js" />
    <None Include="WorldTour/*.json" />
    <None Include="WorldTour/*.tsv" />
    <None Include="package.json" />
    <None Include="esbuild.config.mjs" />
    <None Include="wsconfig.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../WebSharper.D3/WebSharper.D3.fsproj" />
  </ItemGroup>

  <Target Name="ESBuildBundle" AfterTargets="WebSharperCompile">
    <Exec Command="npm install" />
    <Exec Command="node ./esbuild.config.mjs" />
  </Target>

  <Import Project="..\.paket\Paket.Restore.targets" />

</Project>